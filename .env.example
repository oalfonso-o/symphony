# Copy this file to `.env` and fill in local values.
#
# Personal Linear API key used by Symphony.
LINEAR_API_KEY=lin_api_replace_me

# Optional Huekin game defaults. `make run` uses these if present.
# `make symphony` ignores these values and uses WORKFLOW.huekin-runtime.md
# on port 4001.
PORT=4000
WORKFLOW=$HOME/pipprojects/newhuekin/WORKFLOW.md
